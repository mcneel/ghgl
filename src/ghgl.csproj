<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetExt>.gha</TargetExt>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <RhinoPluginType>gha</RhinoPluginType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <OutputPath>..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="resources\*.png" />
    <EmbeddedResource Include="resources\*.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="9.0.26084.12305-wip" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="9.0.26084.12305-wip" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgRhinoCommon)\lib\net8.0\RhinoCommon.dll" Private="false" />
    <Reference Include="$(PkgRhinoCommon)\lib\net8.0\Rhino.UI.dll" Private="false" />
    <Reference Include="$(PkgRhinoCommon)\lib\net8.0\Eto.dll" Private="false" />
    <Reference Include="References\Ed.Core.dll" Private="false" />
    <Reference Include="References\Ed.Eto.dll" Private="false" />
  </ItemGroup>
</Project>
